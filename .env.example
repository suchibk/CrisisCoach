# Optional Nebius/OpenAI-compatible injury classifier.
# Leave all three unset to run the deterministic offline path.
CRISIS_COACH_AI_API_KEY=
CRISIS_COACH_AI_BASE_URL=
CRISIS_COACH_AI_MODEL=

# Optional local incident storage directory (otherwise OS application-data directory).
# CRISIS_COACH_DATA_DIR=

# local (default) or langgraph; langgraph requires the agent extra.
CRISIS_COACH_GRAPH_BACKEND=local

# Optional directory of validated local SourceCorpus JSON files.
# CRISIS_COACH_KNOWLEDGE_DIR=

# Optional bounded specialists, sharing the API key and base URL above.
# Each requires explicit session opt-in after safety clearance.
CRISIS_COACH_AI_SCENE_MODEL=
CRISIS_COACH_AI_VISION_MODEL=

# Optional ElevenLabs voice in Streamlit; separate from the AI provider key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
